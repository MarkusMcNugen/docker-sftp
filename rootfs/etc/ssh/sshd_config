# OpenSSH server configuration for the SFTP container (OpenSSH 10).
#
# Do not edit this file in the container; it is replaced on every image
# update. Put overrides in /config/sshd/sshd_config.d/*.conf instead.
# Those files are copied into /etc/ssh/sshd_config.d/ at start, and the
# Include below reads them before anything else. sshd keeps the first
# value it sees for a keyword, which is what lets a drop-in win over
# every line further down.
Include /etc/ssh/sshd_config.d/*.conf

Port 22
AddressFamily any

HostKey /config/sshd/keys/ssh_host_ed25519_key
HostKey /config/sshd/keys/ssh_host_rsa_key

# Cryptography. Hybrid post-quantum key exchange first; no SHA-1, no CBC,
# no MD5 or 64-bit MACs. Group-exchange moduli below 3072 bits are removed
# from /etc/ssh/moduli at build time. The two plain SHA-2 MACs at the end
# of the list serve older SFTP libraries without encrypt-then-MAC support.
KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512,sntrup761x25519-sha512@openssh.com,curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group18-sha512,diffie-hellman-group16-sha512,diffie-hellman-group-exchange-sha256
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr
MACs hmac-sha2-256-etm@openssh.com,hmac-sha2-512-etm@openssh.com,umac-128-etm@openssh.com,hmac-sha2-512,hmac-sha2-256
RequiredRSASize 2048

# Authentication. Only accounts the entrypoint creates are in sftpusers.
AllowGroups sftpusers
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication yes
PermitEmptyPasswords no
KbdInteractiveAuthentication no
HostbasedAuthentication no
IgnoreRhosts yes
UsePAM no
StrictModes yes
# Keys live outside every chroot, root-owned, so an SFTP user cannot
# grant themselves access by uploading an authorized_keys file.
AuthorizedKeysFile /etc/ssh/authorized_keys/%u
MaxAuthTries 4
LoginGraceTime 30
MaxStartups 10:30:60

# No shells, no forwarding of any kind, no environment from the client.
DisableForwarding yes
AllowTcpForwarding no
AllowAgentForwarding no
AllowStreamLocalForwarding no
X11Forwarding no
GatewayPorts no
PermitTunnel no
PermitTTY no
PermitUserRC no
PermitUserEnvironment no
PrintMotd no
PrintLastLog no

# Drop dead connections after about six minutes without a reply.
ClientAliveInterval 120
ClientAliveCountMax 3

# Performance. Most transferred data is already compressed, so zlib only
# burns CPU, and reverse DNS adds seconds to every login.
Compression no
UseDNS no

# SFTP only, jailed to the user's home directory.
Subsystem sftp internal-sftp
ForceCommand internal-sftp
ChrootDirectory %h

# VERBOSE records the key fingerprint behind each public-key login.
SyslogFacility AUTH
LogLevel VERBOSE
PidFile /run/sshd.pid
